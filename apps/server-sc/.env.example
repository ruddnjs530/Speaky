# ============================================================
# server-sc 환경변수 예시 파일
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 채워 주세요.
#   cp .env.example .env
# .env 파일은 절대 Git에 커밋하지 마세요 (.gitignore 에 포함됨).
# ============================================================

# JWT 서명 시크릿 키 (256비트 이상 랜덤 문자열 권장)
# 생성 예: openssl rand -base64 64
JWT_SECRET=<여기에_랜덤_시크릿_키_입력>

# 테스트 DataLoader 계정 비밀번호
# 개발/테스트 환경에서만 사용됩니다.
TEST_USER_PASSWORD=<일반_사용자_테스트_비밀번호>
TEST_ADMIN_PASSWORD=<관리자_테스트_비밀번호>

# Media Server (기본값이 있으므로 필요한 경우만 설정)
# MEDIA_SERVER_HOST=localhost
# MEDIA_SERVER_PORT=8090
