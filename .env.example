# --- Speaky Environment Configuration ---

# 1. RVC Model Paths (Host Absolute Paths)
# These are required for server-ai to load voice models.
RVC_ASSETS_PATH=/home/user/rvc/assets
RVC_CODE_INFER_PATH=/home/user/rvc/Retrieval-based-Voice-Conversion-WebUI
RVC_CODE_CONFIGS_PATH=/home/user/speaky/apps/server-ai/src/config

# 2. Server Ports
# Change these if you have conflicts on your host.
VITE_PORT=5173
SIGNALING_PORT=8080
MEDIA_PORT=8090
AI_PORT=50051

# 3. Logging Level
LOG_LEVEL=INFO