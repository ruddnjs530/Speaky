# --- Speaky Environment Configuration ---

# 1. RVC Model Paths (Host Absolute Paths)
# These are required for server-ai to load voice models.
RVC_ASSETS_PATH=/home/user/rvc/assets
RVC_CODE_INFER_PATH=/home/user/rvc/Retrieval-based-Voice-Conversion-WebUI
RVC_CODE_CONFIGS_PATH=/home/user/speaky/apps/server-ai/src/config

# 2. Server Ports
# Change these if you have conflicts on your host.
VITE_PORT=5173
SIGNALING_PORT=8080
MEDIA_PORT=8090
AI_PORT=50051

# 3. Logging Level
LOG_LEVEL=INFO

# 4. server-sc (Spring) Security
# JWT 서명용 시크릿 키 — 256비트(32바이트) 이상의 랜덤 문자열 권장
# 생성 예: your-256-bit-secret-key-change-in-production-please-make-it-longer!
JWT_SECRET=<여기에_랜덤_시크릿_키_입력>

# DataLoader 테스트 계정 비밀번호 (개발/테스트 환경 전용) 예: (password123/admin123)
TEST_USER_PASSWORD=<일반_사용자_테스트_비밀번호>
TEST_ADMIN_PASSWORD=<관리자_테스트_비밀번호>
